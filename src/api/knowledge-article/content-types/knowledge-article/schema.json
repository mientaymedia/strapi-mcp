{
  "kind": "collectionType",
  "collectionName": "knowledge_articles",
  "info": {
    "singularName": "knowledge-article",
    "pluralName": "knowledge-articles",
    "displayName": "Knowledge article",
    "description": "Thư viện kiến thức của cộng đồng."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "author": {
      "type": "string",
      "default": "THE FRIENDS"
    },
    "tags": {
      "type": "json"
    },
    "sourceName": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "isSourceLinked": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
